<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.briefd.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BRIEFD__</string>
    <string>serve</string>
    <string>--config</string>
    <string>__HOME__/.briefd/briefd.yaml</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.briefd</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.briefd/briefd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.briefd/briefd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
